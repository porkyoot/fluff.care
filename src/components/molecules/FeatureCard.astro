---
import type { AccentColorName } from '../../tokens/palette';
import RetroWindowFrame from '../atoms/RetroWindowFrame.astro';
import NeonBadge from '../atoms/NeonBadge.astro';
import GlowHeading from '../atoms/GlowHeading.astro';

interface Props {
  title: string;
  badge: string;
  icon: string;
  accentColor: AccentColorName;
  ctaLabel?: string;
  ctaUrl?: string;
  image?: string;
}

const {
  title,
  badge,
  icon,
  accentColor,
  ctaLabel,
  ctaUrl = '#connect',
  image,
} = Astro.props;

const isExternal = ctaUrl.startsWith('http');
---

<a
  href={ctaUrl}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  style="text-decoration:none; color:inherit; display:block; transition:transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);"
>
  <RetroWindowFrame title={`${icon} ${title}`} accent={accentColor} rightTag={badge}>
    {image && (
      <div style="width:100%; height:220px; border-radius:1.5rem; overflow:hidden; margin-bottom:1rem; border:1.5px solid rgba(255,255,255,0.22);">
        <img
          src={image}
          alt={title}
          style="width:100%; height:100%; object-fit:cover;"
          loading="lazy"
        />
      </div>
    )}

    <div style="display:flex; flex-direction:column; gap:14px;">
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
        <NeonBadge label={badge} color={accentColor} />
      </div>

      <GlowHeading as="h3" size="md" gradient={accentColor === 'yellow' ? 'sunny' : 'pinkCyan'}>
        {icon} {title}
      </GlowHeading>

      <div class="cozy-prose">
        <slot />
      </div>

      {ctaLabel && (
        <div style="margin-top:8px; font-family:var(--font-display); font-weight:700; font-size:0.92rem; color:#b3f5ff; display:inline-flex; align-items:center; gap:6px;">
          <span>{ctaLabel} →</span>
        </div>
      )}
    </div>
  </RetroWindowFrame>
</a>
